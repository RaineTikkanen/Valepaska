{
  "compilerOptions": {
    "target": "ES6",
    "outDir": "./build/",
    "module": "node16",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "moduleResolution": "node16",
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true
  },
  "exclude": [
        "node_modules",
        "frontend",
        "dist",
        "build"
    ]
}